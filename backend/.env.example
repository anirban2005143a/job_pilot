# Server
PORT=5000
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Database
MONGO_URI=mongodb://localhost:27017/job_pilot

# Authentication
JWT_SECRET=replace-with-a-long-random-secret

# File and resume limits
MAX_RESUMES=5

# Python integrations
PYTHON_SERVER_BASE_URL=http://127.0.0.1:8000

# Redis and queues
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
MATCH_QUEUE_BATCH_SIZE=5
CONCUREENT_USER_IN_MATCHTING=2

# Job source
JOBSOURCE1_BASE_URL=http://localhost:5001

# Scheduler and job collection
DEFAULT_APPLICATION_INTERVAL_MINUTES=0.5
JOB_POOLING_DELAY_OFFSET_SECONDS=30
STATUS_CHECK_INTERVAL_SECONDS=30

# Recovery
OLD_JOB_RECOVERY_INTERVAL_DAYS=10
OLD_JOB_RECOVERY_POLLING_INTERVAL_SECONDS=60

# Notifications
NOVU_SECRET_KEY=replace-with-your-novu-secret-key
